{
  "type": "object",
  "required": ["segment_id", "question", "answer", "final_emotions", "primary_emotion", "review"],
  "additionalProperties": false,
  "properties": {
    "segment_id": {"type": "string"},
    "question": {"type": "string"},
    "answer": {"type": "string"},
    "final_emotions": {"type": "array", "items": {"type": "string"}},
    "primary_emotion": {"type": "string"},
    "review": {
      "type": "object",
      "required": ["clear", "notes", "scope_count"],
      "additionalProperties": false,
      "properties": {
        "clear": {"type": "boolean"},
        "notes": {"type": "string"},
        "scope_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}

