{
  "type": "object",
  "required": ["evidence", "scopes"],
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "quote"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope_id", "evidence_refs"],
        "additionalProperties": false,
        "properties": {
          "scope_id": {"type": "string", "pattern": "^s[1-9][0-9]*$"},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
