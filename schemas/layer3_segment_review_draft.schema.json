{
  "type": "object",
  "required": ["segment_id", "question", "answer", "valence", "emotion_present", "final_emotions", "review"],
  "additionalProperties": false,
  "properties": {
    "segment_id": {"type": "string"},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "valence": {"enum": ["positive", "negative", "mixed", "neutral"]},
    "emotion_present": {"enum": ["yes", "no"]},
    "final_emotions": {"type": "array", "items": {"type": "string"}},
    "review": {
      "type": "object",
      "required": ["clear", "ambiguity_flags", "note"],
      "additionalProperties": false,
      "properties": {
        "clear": {"type": "boolean"},
        "ambiguity_flags": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    }
  }
}

