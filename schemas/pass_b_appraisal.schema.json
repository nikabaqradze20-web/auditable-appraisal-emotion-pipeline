{
  "type": "object",
  "required": ["scopes"],
  "additionalProperties": false,
  "properties": {
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope_id", "focus", "agency", "temporal", "certainty", "coping",
          "norm_violation_level", "self_blame_level", "resource_depletion",
          "goal_relevance"
        ],
        "additionalProperties": false,
        "properties": {
          "scope_id": {"type": "string", "pattern": "^s[1-9][0-9]*$"},
          "focus": {
            "enum": [
              "threat", "loss", "blocked_goal", "dissatisfaction",
              "felt_alleviation", "benefactor", "future_possibility",
              "specific_object", "general_adequacy"
            ]
          },
          "agency": {
            "type": "array",
            "items": {"enum": ["self", "other", "in_group", "out_group", "circumstance"]},
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          },
          "temporal": {
            "type": "array",
            "items": {"enum": ["past", "present", "future"]},
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true
          },
          "certainty": {
            "type": "array",
            "items": {"enum": ["certain", "uncertain", "hypothetical"]},
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          },
          "coping": {"enum": ["zero", "low", "medium", "high"]},
          "norm_violation_level": {"type": "integer", "minimum": 0, "maximum": 3},
          "self_blame_level": {"type": "integer", "minimum": 0, "maximum": 2},
          "resource_depletion": {"type": "boolean"},
          "goal_relevance": {"enum": ["low", "medium", "high"]}
        }
      }
    }
  }
}
